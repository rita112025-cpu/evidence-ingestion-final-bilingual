{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence Record",
  "type": "object",
  "required": [
    "source_path",
    "sha256",
    "timestamp",
    "extraction_tool",
    "derived_path"
  ],
  "properties": {
    "source_path": {
      "type": "string"
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "sha256": {
      "type": "string"
    },
    "file_size": {
      "type": "integer"
    },
    "mime_type": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "extraction_tool": {
      "type": "string"
    },
    "derived_path": {
      "type": "string"
    },
    "extraction_params": {
      "type": "object"
    },
    "notes": {
      "type": "string"
    }
  }
}